# Settings for deploy/deploy.py. All optional — the defaults are correct, and the
# file holds nothing secret: the repo's own push access is the deploy credential.
# Copy to ~/.config/f3l-series-website/deploy.env (outside every worktree) to
# override any of them. Parsed as KEY=value, not sourced by a shell. Variables
# set in the process environment take precedence over this file.

# F3L_PAGES_REMOTE=origin
# F3L_PAGES_BRANCH=gh-pages
# F3L_SITE_DOMAIN=www.f3lcontestseries.org
# F3L_SITE_URL=https://www.f3lcontestseries.org
