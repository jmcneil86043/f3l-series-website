# Settings for deploy/deploy.py. Copy to ~/.config/f3l-series-website/deploy.env
# (outside every worktree) and chmod 600 it. Never commit a filled-in copy.
#
# The file is parsed as KEY=value, not sourced by a shell. Variables set in the
# process environment take precedence over this file.

# Non-secret; these are the defaults, so the three lines can be left out.
F3L_FTP_HOST=ftp.mcneilco.com
F3L_FTP_USER=jmcneil
F3L_FTP_REMOTE_DIR=/f3l_series

# Set ONE of the two below.
# The FTP password itself:
F3L_FTP_PASSWORD=
# Or a 1Password reference, resolved with `op read` (the op CLI must be installed
# and signed in on this machine), e.g.:
# F3L_FTP_PASSWORD_OP_REF=op://Private/F3L FTP/password
